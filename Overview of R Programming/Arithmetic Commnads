```r
# R Program to perform Arithmetic Operations

# Addition
result1 <- 10 + 5
print(result1)

# Subtraction
result2 <- 10 - 5
print(result2)

# Multiplication
result3 <- 10 * 5
print(result3)

# Division
result4 <- 10 / 5
print(result4)

# Modulus (Remainder)
result5 <- 10 %% 3
print(result5)

# Power
result6 <- 10 ^ 2
print(result6)
```

